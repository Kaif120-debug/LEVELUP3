# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Authentication Configuration
# VITE_SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_ANON_KEY: Your Supabase public API key
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Production Domain Configuration (Optional)
# VITE_SITE_URL: Optional custom domain or production URL for auth email redirects (e.g. https://levelup.app)
# If left unset, defaults dynamically to current window.location.origin in development and preview.
VITE_SITE_URL=

# Razorpay Subscriptions (Test Mode) Configuration
# RAZORPAY_KEY_ID: Razorpay Key ID (e.g. rzp_test_...)
RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET: Razorpay Key Secret (Server-side only secret, never exposed to client)
RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_ID: Razorpay Plan ID for ₹129/month subscription (e.g. plan_...)
RAZORPAY_PLAN_ID=
# RAZORPAY_WEBHOOK_SECRET: Webhook secret for verifying Razorpay webhook signature events (Optional)
RAZORPAY_WEBHOOK_SECRET=

