{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levelup3",
  "main": "_worker.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "single-page-application",
    "not_found_handling": "single-page-application"
  }
}
